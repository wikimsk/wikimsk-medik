<style>:root {--medik: {{medik-color}};}</style>
<div id="mw-wrapper">

	<!-- navbar -->
	<div id="mw-navbar" role="navigation" class="navbar navbar-expand-lg navbar-light d-flex justify-content-between bg-ws">
		<div id="mw-navbar-left">
			{{{html-logo}}}
		</div>
		<div class="dropdown" id="mw-navbar-right">
			{{{html-search-userlinks}}}
		</div>
	</div>

	<!-- sidebar and main content wrapper -->
	<div class="container-fluid" id="mw-main-container">
		<div class="row">

			<!-- navigation sidebar -->
			<div id="mw-navigation" role="navigation" class="col-12 col-md-3 col-xl-2">
				<nav class="nav flex-column d-md-block">
					<div id="sidebar-toc"></div>
					<h2>
						{{{html-navigation-heading}}}
					</h2>
					<div id="site-navigation">
						{{{html-site-navigation}}}
					</div>
					<div class="sidebar-nzcmm">
						<span>Affiliated with</span>
						<a href="https://www.nzcmm.org.nz/"><img src="/w/resources/assets/nzcmm-medium.png" alt="New Zealand College of Musculoskeletal Medicine" width="200" height="150"></a>
					</div>
				</nav>
			</div>

			<!-- main content -->
			<div class="col-12 col-md-9 {{medik-content-width}} py-md-3 px-md-5">
				{{{html-sitenotice}}}
				{{{html-talknotice}}}
				{{{html-aside}}}
				<div class="mw-body" id="content" role="main">
					{{{html-indicators}}}
					<h1 id="firstHeading" class="firstHeading" lang="{{pagelanguage}}">{{{html-pagetitle}}}</h1>
					<div id="siteSub">{{{html-tagline}}}</div>
					<div class="mw-body-content" id="bodyContent">
							<div id="contentSub">
								{{{html-pagesubtitle}}}
								<p>{{{html-undelete}}}</p>
							</div>
							{{{html-bodycontent}}}
							{{{html-clear}}}
							<div class="printfooter">{{{html-printfooter}}}</div>
							{{{html-categorylinks}}}
					</div>
					{{{html-dataaftercontent}}}
				</div>
			</div>

		</div>
	</div>

	{{{html-footer}}}
	<div class="footer-logos">
		<a href="https://www.nzcmm.org.nz/"><img src="/w/resources/assets/nzcmm-medium.png" alt="New Zealand College of Musculoskeletal Medicine" width="250" height="70"></a>
		<a href="https://tmmfnz.org/"><img src="/w/resources/assets/tmmfnz.png" alt="TMMFNZ" width="156" height="78"></a>
	</div>
</div>

